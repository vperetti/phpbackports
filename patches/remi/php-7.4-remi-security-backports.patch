+echo "Similar names are fine:\n";
+foreach (['NULL', 'CON1', 'COM10', 'LPT0', 'console.txt', 'x.nul', 'aux_'] as $name) {
+    $file = $dir . DIRECTORY_SEPARATOR . $name;
+    var_dump(file_put_contents($file, 'x') === 1 && file_exists($file));
+    unlink($file);
+}
+
+rmdir($dir);
+
