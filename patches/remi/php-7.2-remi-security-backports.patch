+    }
+}
+
+echo "Reserved names in paths are rejected:\n";
+foreach (['NUL', 'con', 'COM1', 'LPT9', 'CONIN$', 'NUL.txt', 'con.php', 'aux:stream', 'NUL .txt', 'NUL :txt', '.\\NUL'] as $name) {
+    $blocked = $dir . DIRECTORY_SEPARATOR . $name;
